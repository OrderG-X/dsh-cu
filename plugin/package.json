{
  "name": "dsh-mac-computer-use",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Vision-first Mac computer use for DSH: window list, screenshots, OCR text targeting, numbered elements, background clicks and typing. Works without the accessibility tree.",
  "license": "MIT",
  "author": "OrderG-X",
  "homepage": "https://github.com/OrderG-X/dsh-mac-computer-use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrderG-X/dsh-mac-computer-use.git",
    "directory": "plugin"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "setup.js",
    "panel.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "package.json"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
